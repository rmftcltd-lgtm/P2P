DATABASE_URL="file:./dev.db"
# Optional Postgres (after docker compose up):
# DATABASE_URL="postgresql://relay:relay@localhost:5432/relay"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Lonelyseat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (Stripe) ---
# Omit to use mock authorize/capture + mock Connect payouts.
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email (pick ONE unrestricted provider — not Mailgun sandbox) ---
# Preferred: Resend with a verified domain (no per-recipient opt-in).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Lonelyseat <hello@mg.yourdomain.com>"
#
# Or SendGrid:
# SENDGRID_API_KEY="SG...."
# EMAIL_FROM="Lonelyseat <hello@yourdomain.com>"
#
# Or Mailgun with a verified CUSTOM domain only (sandbox….mailgun.org is ignored):
# MAILGUN_API_KEY="key-..."
# MAILGUN_DOMAIN="mg.yourdomain.com"
# EMAIL_FROM="Lonelyseat <mailgun@mg.yourdomain.com>"
# Optional EU region: MAILGUN_API_BASE="https://api.eu.mailgun.net"
# Debug only: MAILGUN_ALLOW_SANDBOX="true"

# --- SMS (Twilio) ---
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+64..."

# --- Maps (Google) ---
# Enable Maps JavaScript API + Places API on the key.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."
