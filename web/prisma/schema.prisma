// Lonelyseat — peer-to-peer on-the-way delivery for Aotearoa
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  CUSTOMER
  DRIVER
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PackageSize {
  SMALL
  MEDIUM
  LARGE
}

enum KycStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  REQUIRES_PAYMENT
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

/// From Lonelyseat tutorials: One-way / Day Trip / Multiple listings
enum TripType {
  ONE_WAY
  DAY_TRIP
  MULTI
}

enum TripStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  driver       DriverProfile?
  deliveriesAsCustomer Delivery[] @relation("CustomerDeliveries")
  deliveriesAsDriver   Delivery[] @relation("DriverDeliveries")
  trips                DriverTrip[]
  ratingsGiven         Rating[]   @relation("RatingsGiven")
  ratingsReceived      Rating[]   @relation("RatingsReceived")
}

model DriverProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline        Boolean   @default(false)
  lat             Float?
  lng             Float?
  vehicleType     String    @default("car")
  rating          Float     @default(5.0)
  completedCount  Int       @default(0)
  kycStatus       KycStatus @default(UNVERIFIED)
  kycSubmittedAt  DateTime?
  licenseNumber   String?
  idDocumentNote  String?
  stripeAccountId String?
  lastSeenAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Driver "lonely seat" route listing (videos: one-way, day trip, multiple)
model DriverTrip {
  id            String     @id @default(cuid())
  driverId      String
  driver        User       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tripType      TripType
  /// Groups MULTI listing legs created together
  batchId       String?
  fromAddress   String
  fromLat       Float
  fromLng       Float
  toAddress     String
  toLat         Float
  toLng         Float
  departAt      DateTime
  /// Set for DAY_TRIP return window
  returnAt      DateTime?
  /// JSON array of space keys: shoebox, frontseat, backseat, boot_sedan, boot_hatch, boot_other, trailer
  spaces        String     @default("[\"shoebox\"]")
  vehicleType   String     @default("car")
  notes         String?
  status        TripStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deliveries    Delivery[]

  @@index([driverId])
  @@index([status])
  @@index([departAt])
  @@index([fromLat, fromLng])
  @@index([batchId])
}

model Delivery {
  id              String         @id @default(cuid())
  customerId      String
  customer        User           @relation("CustomerDeliveries", fields: [customerId], references: [id])
  driverId        String?
  driver          User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  tripId          String?
  trip            DriverTrip?    @relation(fields: [tripId], references: [id])
  status          DeliveryStatus @default(PENDING)

  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  dropoffAddress  String
  dropoffLat      Float
  dropoffLng      Float

  /// Preferred pickup window (from List Item tutorial)
  preferredDate   DateTime?
  packageSize     PackageSize    @default(SMALL)
  /// Lonelyseat space key when listed (shoebox/frontseat/...)
  spaceNeeded     String         @default("shoebox")
  packageNotes    String?
  offerAmount     Float
  distanceKm      Float
  platformFee     Float          @default(0)
  /// Lonely Cover: $5 protects up to $2000
  lonelyCover     Boolean        @default(false)
  lonelyCoverFee  Float          @default(0)
  paymentStatus   PaymentStatus  @default(UNPAID)
  stripePaymentIntentId String?
  dropoffPhotoUrl String?

  acceptedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  events          DeliveryEvent[]
  rating          Rating?

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@index([tripId])
  @@index([pickupLat, pickupLng])
  @@index([paymentStatus])
}

model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     DeliveryStatus
  note       String?
  lat        Float?
  lng        Float?
  createdAt  DateTime       @default(now())

  @@index([deliveryId])
}

model Rating {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("RatingsReceived", fields: [toUserId], references: [id])
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([toUserId])
}
