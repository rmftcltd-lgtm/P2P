{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/registration-reminders",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/marketplace-maintenance",
      "schedule": "*/15 * * * *"
    }
  ]
}
